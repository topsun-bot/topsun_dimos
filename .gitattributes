# Handle line endings automatically for files Git considers text,
# converting them to LF on checkout.
* text=auto eol=lf
# Ensure Python files always use LF for line endings.
*.py text eol=lf
# Treat designated file types as binary and do not alter their contents or line endings.
*.png filter=lfs diff=lfs merge=lfs -text binary
*.jpg filter=lfs diff=lfs merge=lfs -text binary
*.jpeg filter=lfs diff=lfs merge=lfs -text binary
*.ico binary
*.pdf binary
# Explicit LFS tracking for test files
/data/.lfs/*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.onnx filter=lfs diff=lfs merge=lfs -text binary
*.mp4 filter=lfs diff=lfs merge=lfs -text binary
*.mov filter=lfs diff=lfs merge=lfs -text binary
*.gif filter=lfs diff=lfs merge=lfs -text binary
*.foxe filter=lfs diff=lfs merge=lfs -text binary
docs/capabilities/memory/assets/** filter=lfs diff=lfs merge=lfs -text
docs/capabilities/memory/assets/.gitattributes -filter -diff -merge text
docs/capabilities/mapping/assets/** filter=lfs diff=lfs merge=lfs -text
# Mintlify deploy does not fetch Git LFS; keep site branding as normal blobs.
docs/assets/dimensional-logo-master-transparent.png -filter -diff -merge
docs/assets/favicon.png -filter -diff -merge
# Tiny official recharge marker must remain clonable without the upstream LFS service.
jiangtao/aruco_recharge_20250624/aruco_id0.png -filter -diff -merge binary
# Mid360 simulation recordings and generated relocalization maps are binary
# validation assets. Keep them reproducible without inflating normal Git blobs.
jiangtao/artifacts/mid360/**/*.db filter=lfs diff=lfs merge=lfs -text binary
jiangtao/artifacts/mid360/**/*.lcm filter=lfs diff=lfs merge=lfs -text binary
jiangtao/artifacts/mid360/**/*-odom.csv filter=lfs diff=lfs merge=lfs -text
# DimSim scene data and agent model
misc/DimSim/public/sims/*.json filter=lfs diff=lfs merge=lfs -text
misc/DimSim/public/embodiment/*.glb filter=lfs diff=lfs merge=lfs -text
misc/DimSim/scenes/**/*.glb filter=lfs diff=lfs merge=lfs -text
misc/DimSim/scenes/**/*.gltf filter=lfs diff=lfs merge=lfs -text
