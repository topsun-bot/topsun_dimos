# Copy to tools/lark/.env and fill in.
# This file is loaded automatically by lark_cli.py — do NOT commit the real .env.

# 飞书开放平台 → 凭证与基础信息
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 如果你用的是 Lark 国际版，改成 https://open.larksuite.com
LARK_HOST=https://open.feishu.cn
