# Copy to ai_longrun_harness/config.env and customize.

# PR target branch (repo convention: main)
PR_TARGET_BRANCH="main"

# Remote used for push/PR
PR_REMOTE="origin"

# Optional commit message when auto-commit is used
AUTO_COMMIT_MESSAGE="chore: prepare auto pipeline run"

# --- Hardware verification funnel (docs/development/hardware_verification_loop.md) ---
# Both gates are opt-in and disabled by default so existing dev-loop-to-PR
# usage is unaffected until a project wires up the commands below.

# Set to 1 to run simulation regression (Stage 2) between the dev loop and
# the PR pipeline. Requires SIM_REGRESSION_CMD.
SIM_GATE_ENABLED="0"
# Command run by run_sim_gate.sh, e.g.:
# SIM_REGRESSION_CMD="uv run pytest -m mujoco dimos/e2e_tests"
SIM_REGRESSION_CMD=""

# Set to 1 to run real-hardware verification (Stage 4-7) between the dev loop
# and the PR pipeline. Requires HW_VERIFY_CMD. Keep this 0 unless a real,
# reviewed hardware driver is wired up -- see run_hw_verify.sh --help.
HW_VERIFY_ENABLED="0"
# Command run by run_hw_verify.sh; must deploy, run HW_VERIFY_REPEAT_TRIALS
# repeated trials, judge each with dimos.verification.judge, and emit an
# evidence bundle (dimos.verification.evidence) on any failure.
HW_VERIFY_CMD=""
# Number of repeated trials required to pass before a task spec is considered
# reliable enough to merge (a single passing trial has little statistical
# weight for a physical system).
HW_VERIFY_REPEAT_TRIALS="5"
