# DimOS environment configuration
# Copy to .env and fill in your keys.  (.env is gitignored — do not commit secrets.)

# G1 greeter TTS on Orin (CosyVoice; SpeakSkill reads DASHSCOPE_API_KEY from env)
# DASHSCOPE_API_KEY="sk-your-dashscope-key"

# G1 greeter tag_location LLM intro (optional; use one of the pairs below)
# OPENAI_API_KEY="sk-your-deepseek-or-openai-key"
# OPENAI_BASE_URL="https://api.deepseek.com"
# DIMOS_GREETER_INTRO_MODEL="deepseek-chat"

# DeepSeek (for unitree-go2-agentic-deepseek blueprint)
OPENAI_API_KEY="sk-xxx"
OPENAI_BASE_URL="https://api.deepseek.com"

# OpenAI (for default unitree-go2-agentic blueprint)
# OPENAI_API_KEY="sk-xxx"

# Unitree Go2 WebRTC (when robot requires AES key)
# UNITREE_AES_128_KEY="your-32-char-hex-key"
